/your-mail-mcp

# Personal, machine-specific notes. See CLAUDE.md.
CLAUDE.local.md

# Local configuration and secrets. Never commit these.
/.env
/accounts.json

# Local tool configuration, not repo content.
/.claude/

# Machine-specific deployment config. Never commit.
/compose.override.yaml

# Per-deployment secrets, token helper and data under deploy/. The
# templates (*.example.*, compose.yaml, README.md) stay tracked.
/deploy/*/.env
/deploy/*/renew.env
/deploy/*/accounts.json
/deploy/*/oauth/
/deploy/*/mail/
/deploy/*/index/

# Playwright MCP session dumps.
/.playwright-mcp/

# Git worktrees for plan execution.
/.worktrees/
